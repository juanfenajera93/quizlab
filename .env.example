# Copy this file to .env and fill in your values

# Admin panel password (required)
ADMIN_PASSWORD=changeme

# Session secret key — generate a random string for production
SECRET_KEY=change-this-to-a-random-secret-string

# Local development uses SQLite by default — leave DATABASE_URL blank
# For production with Supabase, set DATABASE_URL to your Supabase connection string
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
